# `vite build --mode deploy`: the build the gateway serves (docs/DEPLOYMENT.md),
# used by CI and by deploy/demo_local.ps1. No secrets here.
#
# Empty on purpose: the gateway serves this bundle and the API from one
# origin, so API calls are relative and need no CORS.
VITE_API_BASE_URL=
# No database in this deployment; a click analyzes a square area instead.
VITE_CLICK_ANALYZES_AREA=true
