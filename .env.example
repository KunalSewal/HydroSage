# Read by docker-compose.yml itself (variable substitution: ${VAR}), not
# by the application -- that's backend/.env, a separate file. Copy this to
# a real .env in this same directory before running `docker compose up`.

# Host ports to publish -- change these if they collide with something
# else already running on the machine.
API_PORT=8000
FRONTEND_PORT=8080

# The backend's URL as reachable from a browser (i.e. the public one,
# not an internal Docker hostname). Baked into the frontend's static
# build at image-build time -- changing this after building the image
# requires rebuilding the frontend image, not just restarting it.
VITE_API_BASE_URL=http://localhost:8000
